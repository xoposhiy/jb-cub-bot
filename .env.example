BOT_TOKEN=123456:replace-me
LINK_SECRET=generate-a-long-random-string
RIGHTS_SHEET_ID=spreadsheet-id-holding-Cohorts-and-Rights-tabs
# Local dev reads the service-account key from a file. Railway can only pass
# secrets as env vars, so there set GOOGLE_SERVICE_ACCOUNT_JSON to the whole
# key instead and leave GOOGLE_SERVICE_ACCOUNT_FILE unset. Set exactly one.
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# Four slashes means an absolute path, three means relative. On a mounted
# volume use: DATABASE_URL=sqlite:////data/jbcub_bot.db
DATABASE_URL=sqlite:///jbcub_bot.db
LINK_TTL_SECONDS=86400
BOOTSTRAP_ADMIN_IDS=111111111,222222222
COHORTS_TAB=Cohorts
RIGHTS_TAB=Rights
GRADEBOOK_TAB=Gradebook
# Private staff chat for crash reports and unanswered requests. Add the bot to
# it first. Empty means those go to BOOTSTRAP_ADMIN_IDS in DM instead.
LOG_CHAT_ID=
# Knowledge base search. Only the LLM key is required — without it /ask answers
# that the feature is not configured. The other two are optional: an empty base
# URL means OpenAI itself, and any OpenAI-compatible chat-completions endpoint
# works, so point KB_LLM_BASE_URL at a local LiteLLM proxy for a debug run and
# set KB_LLM_MODEL to whatever name that endpoint routes.
KB_LLM_API_KEY=
KB_LLM_BASE_URL=
KB_LLM_MODEL=gpt-5.6-luna
# Sent as reasoning_effort. "none" because OpenAI's small models reject
# function tools on chat completions with reasoning on. Leave empty to omit the
# parameter for a gateway whose model does not understand it.
KB_LLM_REASONING_EFFORT=none
KB_REPO=xoposhiy/cub-kb
KB_TTL_SECONDS=3600
# A brake on the agent as a whole, not on any one asker: nobody is expected to
# be worth banning, so this is a smoke alarm, not a quota. Tripping it answers
# "try again later" and pings the admins in LOG_CHAT_ID, so it is meant to be
# far above normal use.
KB_RATE_LIMIT=100
KB_RATE_WINDOW_SECONDS=3600
# Optional, and purely about quota. The bot makes one GitHub API call per TTL to
# see whether the base moved; unauthenticated that API allows 60 an hour per IP,
# and Railway shares one outbound address between tenants, so the budget runs
# out through no fault of ours. Any token raises it to 5000 an hour in a bucket
# of our own. The base is public, so grant the token nothing: a fine-grained
# token with "Public Repositories (read-only)" and no permissions is enough.
KB_GITHUB_TOKEN=
